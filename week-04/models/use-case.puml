@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle outline

left to right direction

actor "Student" as student
actor "Administrator" as admin

rectangle "Smart Campus Study Room Booking System" {

  usecase "View Room Availability" as UC_ViewAvailability
  usecase "Book Room" as UC_BookRoom
  usecase "Cancel Own Booking" as UC_CancelBooking

  usecase "Block Room" as UC_BlockRoom
  usecase "Unblock Room" as UC_UnblockRoom
  usecase "Review Room Usage" as UC_ReviewUsage

  student -- UC_ViewAvailability
  student -- UC_BookRoom
  student -- UC_CancelBooking

  admin -- UC_BlockRoom
  admin -- UC_UnblockRoom
  admin -- UC_ReviewUsage

  note right of UC_BookRoom
    R1: Start must be in the future.
    Duration > 0 and <= 2 hours.

    R2: Active bookings for the
    same room cannot overlap.

    R3: A blocked room cannot
    accept a new booking.

    R4: A successful booking
    produces a confirmation.
  end note

  note bottom of UC_BookRoom
    Assumption A1:
    Bookings that touch at the boundary
    do not overlap.
    Example: 10:00-12:00 and 12:00-13:00
    are allowed.

    Assumption A2:
    Existing bookings remain when a room
    is blocked. Blocking prevents new bookings.
  end note
}

@enduml